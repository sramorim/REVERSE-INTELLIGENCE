{
  "name": "reverse-intelligence-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REVERSE INTELLIGENCE backend: projects, uploads, REA analysis jobs and reports.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "admin": "node --disable-warning=ExperimentalWarning dist/src/admin.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pdfkit": "0.20.2",
    "rea-agents": "6.5.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "typescript": "5.9.3"
  }
}